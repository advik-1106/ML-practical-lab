    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 1. Load data\n",
        "# =========================================================\n",
        "\n",
        "file_path = \"/content/drive/MyDrive/Colab Notebooks/placement_predict_50k_adjusted (1).csv\"\n",
        "\n",
        "df = pd.read_csv(file_path)\n",
        "\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "print(\"\\nColumns:\")\n",
        "print(df.columns.tolist())\n",
        "\n",
        "# Target column\n",
        "target_col = \"CGPA\"\n",
        "\n",
        "# Check that target exists\n",
        "if target_col not in df.columns:\n",
        "    raise ValueError(f\"Target column '{target_col}' not found in dataset.\")\n",
        "\n",
        "print(\"\\nTarget:\", target_col)\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 2. Prepare features\n",
        "# =========================================================\n",
        "\n",
        "# SGPA columns\n",
        "sgpa_cols = [f\"SGPA_Sem{i}\" for i in range(1, 9)]\n",
        "\n",
        "# Columns that should NOT be used as input features\n",
        "drop_cols = [\n",
        "    target_col,\n",
        "    \"StudentID\",\n",
        "    \"CGPA_Tier\"\n",
        "] + sgpa_cols\n",
        "\n",
        "# Only drop columns that actually exist\n",
        "drop_cols = [c for c in drop_cols if c in df.columns]\n",
        "\n",
        "# Remove target/ID/SGPA/etc.\n",
        "feature_df = df.drop(columns=drop_cols)\n",
        "\n",
        "# Keep only numerical columns\n",
        "feature_df = feature_df.select_dtypes(include=[np.number])\n",
        "\n",
        "# Fill missing numerical values with median\n",
        "feature_df = feature_df.fillna(feature_df.median())\n",
        "\n",
        "# Remove rows where target is missing\n",
        "valid_rows = df[target_col].notna()\n",
        "\n",
        "X = feature_df.loc[valid_rows].values\n",
        "y = df.loc[valid_rows, target_col].values.reshape(-1, 1)\n",
        "\n",
        "print(\"\\nFeatures used:\")\n",
        "print(feature_df.columns.tolist())\n",
        "\n",
        "print(\"\\nNumber of features:\", X.shape[1])\n",
        "print(\"Number of samples:\", X.shape[0])\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 3. Train / Test Split\n",
        "# =========================================================\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.20,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "print(\"\\nTraining samples:\", X_train.shape[0])\n",
        "print(\"Testing samples :\", X_test.shape[0])\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 4. Feature Scaling\n",
        "# =========================================================\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_train = scaler.fit_transform(X_train)\n",
        "X_test = scaler.transform(X_test)\n",
        "\n",
        "# Add bias/intercept column\n",
        "X_train_b = np.c_[\n",
        "    np.ones((X_train.shape[0], 1)),\n",
        "    X_train\n",
        "]\n",
        "\n",
        "X_test_b = np.c_[\n",
        "    np.ones((X_test.shape[0], 1)),\n",
        "    X_test\n",
        "]\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 5. Gradient Descent Implementation\n",
        "# =========================================================\n",
        "\n",
        "def gradient_descent(X, y, lr=0.01, n_iters=1000):\n",
        "\n",
        "    m, n = X.shape\n",
        "\n",
        "    # Initialize weights\n",
        "    theta = np.zeros((n, 1))\n",
        "\n",
        "    losses = []\n",
        "\n",
        "    for i in range(n_iters):\n",
        "\n",
        "        # Prediction\n",
        "        y_pred = X @ theta\n",
        "\n",
        "        # Error\n",
        "        error = y_pred - y\n",
        "\n",
        "        # Mean Squared Error / 2\n",
        "        loss = (1 / (2 * m)) * np.sum(error ** 2)\n",
        "\n",
        "        losses.append(loss)\n",
        "\n",
        "        # Gradient\n",
        "        gradient = (1 / m) * (X.T @ error)\n",
        "\n",
        "        # Update weights\n",
        "        theta = theta - lr * gradient\n",
        "\n",
        "        # Print progress\n",
        "        if i % 100 == 0:\n",
        "            print(\n",
        "                f\"Iteration {i:4d} | \"\n",
        "                f\"Loss: {loss:.6f}\"\n",
        "            )\n",
        "\n",
        "    return theta, losses\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 6. Train Gradient Descent Model\n",
        "# =========================================================\n",
        "\n",
        "theta, losses = gradient_descent(\n",
        "    X_train_b,\n",
        "    y_train,\n",
        "    lr=0.01,\n",
        "    n_iters=1000\n",
        ")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 7. Make Predictions\n",
        "# =========================================================\n",
        "\n",
        "y_pred = X_test_b @ theta\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 8. Evaluate Gradient Descent Model\n",
        "# =========================================================\n",
        "\n",
        "mse = mean_squared_error(y_test, y_pred)\n",
        "rmse = np.sqrt(mse)\n",
        "r2 = r2_score(y_test, y_pred)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"GRADIENT DESCENT RESULTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(\"\\nFinal weights (theta):\")\n",
        "print(theta.ravel())\n",
        "\n",
        "print(f\"\\nTest MSE  : {mse:.6f}\")\n",
        "print(f\"Test RMSE : {rmse:.6f}\")\n",
        "print(f\"Test R²   : {r2:.6f}\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 9. Compare with sklearn Linear Regression\n",
        "# =========================================================\n",
        "\n",
        "sk_model = LinearRegression()\n",
        "\n",
        "sk_model.fit(X_train, y_train.ravel())\n",
        "\n",
        "sk_pred = sk_model.predict(X_test)\n",
        "\n",
        "sk_mse = mean_squared_error(y_test.ravel(), sk_pred)\n",
        "sk_rmse = np.sqrt(sk_mse)\n",
        "sk_r2 = r2_score(y_test.ravel(), sk_pred)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"SKLEARN LINEAR REGRESSION RESULTS\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "print(f\"\\nTest MSE  : {sk_mse:.6f}\")\n",
        "print(f\"Test RMSE : {sk_rmse:.6f}\")\n",
        "print(f\"Test R²   : {sk_r2:.6f}\")\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 10. Plot Results\n",
        "# =========================================================\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Plot 1: Loss Curve\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "axes[0].plot(\n",
        "    range(len(losses)),\n",
        "    losses,\n",
        "    color=\"steelblue\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "axes[0].set_title(\n",
        "    \"Gradient Descent: Loss vs Iterations\"\n",
        ")\n",
        "\n",
        "axes[0].set_xlabel(\"Iteration\")\n",
        "\n",
        "axes[0].set_ylabel(\n",
        "    \"Loss (1/2m × Sum Squared Error)\"\n",
        ")\n",
        "\n",
        "axes[0].grid(alpha=0.3)\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# Plot 2: Actual vs Predicted\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "axes[1].scatter(\n",
        "    y_test.ravel(),\n",
        "    y_pred.ravel(),\n",
        "    alpha=0.15,\n",
        "    s=8,\n",
        "    color=\"darkorange\"\n",
        ")\n",
        "\n",
        "# Perfect prediction line\n",
        "min_value = min(\n",
        "    y_test.min(),\n",
        "    y_pred.min()\n",
        ")\n",
        "\n",
        "max_value = max(\n",
        "    y_test.max(),\n",
        "    y_pred.max()\n",
        ")\n",
        "\n",
        "axes[1].plot(\n",
        "    [min_value, max_value],\n",
        "    [min_value, max_value],\n",
        "    color=\"black\",\n",
        "    linestyle=\"--\",\n",
        "    linewidth=1.5,\n",
        "    label=\"Perfect Prediction\"\n",
        ")\n",
        "\n",
        "axes[1].set_title(\n",
        "    \"Actual vs Predicted CGPA\"\n",
        ")\n",
        "\n",
        "axes[1].set_xlabel(\"Actual CGPA\")\n",
        "\n",
        "axes[1].set_ylabel(\"Predicted CGPA\")\n",
        "\n",
        "axes[1].legend()\n",
        "\n",
        "axes[1].grid(alpha=0.3)\n",
        "\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "\n",
        "# =========================================================\n",
        "# 11. Save Plot\n",
        "# =========================================================\n",
        "\n",
        "output_path = \"/content/gradient_descent_plots.png\"\n",
        "\n",
        "plt.savefig(\n",
        "    output_path,\n",
        "    dpi=150,\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nPlots saved to: {output_path}\"\n",
        ")\n",
        "\n",
        "plt.show()\n"
      ],
